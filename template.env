# 复制为 .env 后填写，.env 不进 git
SPRING_PROFILES_ACTIVE=demo

# PostgreSQL：eas_owner 为迁移账号，eas_app 为运行账号
DB_OWNER_PASSWORD=change_me_owner
DB_PASSWORD=change_me_app

# JWT 密钥，至少 32 字节
JWT_SECRET=change_me_to_a_random_string_at_least_32_bytes

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

# SMTP，默认使用 mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
