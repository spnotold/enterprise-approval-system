# 复制为 .env 后填写，.env 不进 git
# demo：加载演示账号与示例数据；正式部署留空，并设置 EAS_ADMIN_PASSWORD 创建首个管理员
SPRING_PROFILES_ACTIVE=demo
EAS_ADMIN_PASSWORD=

# PostgreSQL：eas_owner 为表属主（Flyway 迁移），eas_app 为运行账号（仅 DML）
DB_OWNER_PASSWORD=change_me_owner
DB_PASSWORD=change_me_app

# MinIO：root 账号只给 minio-init 使用，后端使用专用 key
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_root
MINIO_APP_ACCESS_KEY=eas-app
MINIO_APP_SECRET_KEY=change_me_minio_app

# JWT 密钥，至少 32 字节。
# 必须用随机值替换 template.env 中的占位串，公开值任何人可签发令牌冒充管理员。
# 生成命令：openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_string_at_least_32_bytes

# SMTP，默认使用 mailpit（演示环境无认证、无加密）。
# 替换为真实 SMTP 时：填写 SMTP_USER / SMTP_PASSWORD 并设 SMTP_AUTH=true，
# 465 端口设 SMTP_SSL=true；587 / 25 端口设 SMTP_STARTTLS=true。
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false

# 对外端口与访问地址
HTTP_PORT=80
MAILPIT_PORT=8025
APP_BASE_URL=http://localhost
# 通过 http（如局域网 IP）访问时为 false；部署在 https 后改为 true
COOKIE_SECURE=false
# 通过 nginx 同源部署时留空，不需要额外来源；只有前端开发服务器或其他来源跨域访问时才需填写。
# 多个来源用逗号分隔（如 http://localhost:5173,http://localhost:5174），包含协议和端口，不带路径或末尾斜杠。
EAS_CORS_ALLOWED_ORIGINS=
# nginx 前面还有终止 TLS 的反向代理时，填该代理的地址或网段（多个用逗号分隔，如 172.16.0.0/12）。
# nginx 只从这些来源的请求里采信 X-Forwarded-For，用于登录/注册的 IP 限流与审计日志。
# 留空（默认）表示直连 nginx，不信任任何 X-Forwarded-For；不要填 0.0.0.0/0，否则客户端可伪造 IP。
TRUSTED_PROXY_CIDR=
